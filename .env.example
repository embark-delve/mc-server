# Non-secret process configuration only. The CLI does not auto-load .env files.
# You may explicitly export these variables in your terminal.
# SERVER_MEMORY=4G
# BASE_DIR=/absolute/path/to/dedicated/profile
# MC_PROFILE=forge
#
# DO NOT put admin or Microsoft passwords in this file.
# Set/reset the single admin interactively:
#   uv run --locked minecraft-server admin owner
# This stores a salted password hash in the private profile access store.
# Automation can supply a password through --password-stdin from a secret manager.
# RCON secrets are generated in the private profile and never committed.
