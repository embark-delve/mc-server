{
  "name": "minecraft-server-manager-ui",
  "version": "2.0.0",
  "private": true,
  "description": "Development checks for the bundled static management UI",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint src/web/static/app.js",
    "format:check": "prettier --check src/web/static package.json eslint.config.mjs",
    "format": "prettier --write src/web/static package.json eslint.config.mjs",
    "check": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9"
  }
}
